---
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import Signup from '../../components/Signup.astro';
import Cover from '../../components/Cover.astro';
import Meters from '../../components/Meters.astro';
import { coverAbs } from '../../lib/covers';
import { tropeHref } from '../../lib/tropes';
import { bookBySlug, listsForBook, ratingSummary, tropeTally, reactionTally, similarBooks, ratingsForBooks, recsForBook, SPICE, DARK } from '../../lib/data';
const book = await bookBySlug(Astro.params.slug!);
if (!book) return new Response('Not found', { status: 404 });
const [lists, rating, tropes, reacts, similar, recs] = await Promise.all([listsForBook(book.id), ratingSummary(book.id), tropeTally(book.id), reactionTally(book.id), similarBooks(book.id, book.tropes), recsForBook(book.id)]);
const simRatings = await ratingsForBooks(similar.map((b) => b.id));
const voted = new Map(tropes.map((t) => [t.trope, t.n]));
const allTropes = [...new Set([...book.tropes, ...tropes.map((t) => t.trope)])].sort((a, b) => (voted.get(b) || 0) - (voted.get(a) || 0));
const jsonLd: any = { '@context': 'https://schema.org', '@type': 'Book', name: book.title, author: { '@type': 'Person', name: book.author }, image: coverAbs(book.cover_url, Astro.site) };
const site = String(Astro.site || 'https://www.darkromancefan.com').replace(/\/$/, '');
const recsLd = recs.count ? { '@context': 'https://schema.org', '@type': 'ItemList', name: `Books like ${book.title}`, numberOfItems: recs.count,
  itemListElement: recs.sections.flatMap((x) => x.recs).map((r, i) => ({ '@type': 'ListItem', position: i + 1,
    item: { '@type': 'Book', name: r.title, author: { '@type': 'Person', name: r.author }, ...(r.linked_slug ? { url: `${site}/books/${r.linked_slug}` } : {}) } })) } : null;
const pageTitle = recs.count
  ? `${book.title} by ${book.author}: ${recs.count} books like it, spice level & tropes | Dark Romance Fan`
  : `${book.title} by ${book.author}: spice level, tropes & reader ratings | Dark Romance Fan`;
const pageDesc = recs.count
  ? `${recs.count} books like ${book.title}, from less dark reads to darker ones, MM and sapphic picks. ${book.blurb}`.slice(0, 300)
  : `${book.blurb} Reader ratings for spice and darkness, trope tags and comments.`;
if (rating.n >= 3) jsonLd.aggregateRating = { '@type': 'AggregateRating', ratingValue: rating.overall, ratingCount: rating.n, bestRating: 5, worstRating: 1 };
const scales = [
  { name: 'overall', label: 'Overall', opts: ['', 'Meh', 'Fine', 'Good', 'Loved it', 'Obsessed'] },
  { name: 'spice', label: 'Spice', opts: SPICE },
  { name: 'darkness', label: 'Darkness', opts: DARK },
];
if (!Astro.url.search) Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');
---
<Base title={pageTitle} description={pageDesc} jsonLd={recsLd ? [jsonLd, recsLd] : jsonLd} image={book.cover_url}>
  <div class="wrap">
    <div class="bookhead">
      <Cover book={book} eager />
      <div>
        <div class="eyebrow">Dark romance{book.series && ` · ${book.series}`}</div>
        <h1 style="font-size:clamp(2.2rem,4.5vw,3.6rem)">{book.title}</h1>
        <div class="meta" style="font-size:1.02rem">by <strong style="color:var(--ink)">{book.author}</strong>{book.year && ` · first published ${book.year}`}</div>
        <div class="scorecard">
          <div><span class="big">{rating.n ? rating.overall : '–'}<span style="font-size:1rem;color:var(--muted)">/5</span></span><span class="lbl">Readers · {rating.n} {rating.n === 1 ? 'rating' : 'ratings'}</span></div>
          <div><span class="big" style="color:var(--blood-2)">{rating.n ? rating.spice : '–'}</span><span class="lbl">Spice{rating.n ? ` · ${SPICE[Math.round(rating.spice)]}` : ''}</span></div>
          <div><span class="big">{rating.n ? rating.darkness : '–'}</span><span class="lbl">Darkness{rating.n ? ` · ${DARK[Math.round(rating.darkness)]}` : ''}</span></div>
        </div>
        <p style="font-size:1.08rem">{book.blurb}</p>
        <div class="buy">
          <a class="btn" href={`/go/${book.slug}?store=amazon`} rel="sponsored nofollow">Buy on Amazon</a>
          <a class="btn ghost" href={`/go/${book.slug}?store=bookshop`} rel="sponsored nofollow">Bookshop.org</a>
          <a class="btn ghost" href="#rate">Rate it</a>
        </div>
        {book.content_note && <div class="note"><strong>Content note.</strong> {book.content_note}</div>}
        {recs.count > 0 && <p class="meta"><a href="#books-like">{recs.count} books like {book.title} ↓</a></p>}
        {lists.length > 0 && <p class="meta">Featured in: {lists.map((l, i) => <>{i > 0 && ' · '}<a href={`/lists/${l.slug}`}>{l.title}</a></>)}</p>}
      </div>
    </div>
  </div>


  {recs.count > 0 && (
    <section id="books-like" class="recs">
      <div class="wrap">
        <div class="eyebrow">What to read next</div>
        <h2>Books like {book.title}</h2>
        {book.recs_intro && <p class="lede">{book.recs_intro}</p>}
        <nav class="jump" aria-label="Jump to a section">{recs.sections.map((x, i) => <a href={`#recs-${i}`}>{x.heading}</a>)}</nav>
        {recs.sections.map((x, i) => (
          <div class="recgroup" id={`recs-${i}`}>
            <h3>{x.heading}</h3>
            {x.note && <p class="meta">{x.note}</p>}
            <ol class="reclist">
              {x.recs.map((r) => {
                const cover = r.linked_cover || r.cover_url;
                return (
                  <li class="rec">
                    {r.linked_slug
                      ? <a href={`/books/${r.linked_slug}`}><Cover book={{ title: r.title, author: r.author, cover_url: cover }} /></a>
                      : <Cover book={{ title: r.title, author: r.author, cover_url: cover }} />}
                    <div>
                      <h4>{r.linked_slug ? <a href={`/books/${r.linked_slug}`}>{r.title}</a> : r.title}</h4>
                      <div class="by">by {r.author}</div>
                      <p>{r.reason}</p>
                      <div class="recbuy">
                        <a class="btn small" href={`/go/rec/${r.id}`} rel="sponsored nofollow">Buy on Amazon</a>
                        {r.linked_slug && <a class="btn small ghost" href={`/books/${r.linked_slug}`}>Ratings & tropes</a>}
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </div>
        ))}
        <p class="meta">We may earn a commission when you buy through these links, at no extra cost to you.</p>
      </div>
    </section>
  )}

  <div class="wrap narrow">
    <section id="tropes" style="padding-top:20px">
      <div class="eyebrow">Tagged by readers</div>
      <h2>Tropes</h2>
      <p class="meta">Tap a trope to agree with it, or add one we've missed.</p>
      <div class="tags">
        {allTropes.map((t) => (
          <form method="post" action="/api/trope" style="display:inline">
            <input type="hidden" name="book_id" value={book.id} /><input type="hidden" name="trope" value={t} />
            <button class="tag" type="submit">{t}<b>{voted.get(t) || 0}</b></button>
          </form>
        ))}
      </div>
      <form method="post" action="/api/trope" style="display:flex;gap:8px;max-width:420px;margin-top:8px">
        <input type="hidden" name="book_id" value={book.id} />
        <input name="trope" placeholder="e.g. touch her and die" maxlength="40" aria-label="Add a trope" />
        <button class="btn small" type="submit">Add</button>
      </form>
      {book.tropes.length > 0 && <p class="meta" style="margin-top:14px">More books like this: {book.tropes.map((t, i) => <>{i > 0 && ' · '}<a href={tropeHref(t)}>{t}</a></>)}</p>}
    </section>

    <div class="twocol">
      <section id="react" style="padding-top:0">
        <div class="panel" style="height:100%">
          <h3>Have you read it?</h3>
          <div class="react">
            {[['loved', '🖤 Loved it'], ['dnf', 'Did not finish'], ['tbr', 'Want to read']].map(([k, label]) => (
              <form method="post" action="/api/react"><input type="hidden" name="book_id" value={book.id} /><input type="hidden" name="kind" value={k} />
                <button type="submit">{label}<b>{reacts[k] || 0}</b></button></form>
            ))}
          </div>
        </div>
      </section>
      <section id="rate" style="padding-top:0">
        <div class="panel">
          <h3>Rate this book</h3>
          {Astro.url.searchParams.get('r') && <div class="flash">Thanks, your rating is in.</div>}
          <form class="form" method="post" action="/api/rate">
            <input type="hidden" name="book_id" value={book.id} />
            {scales.map((s) => (
              <label>{s.label}
                <select name={s.name} required={s.name === 'overall'}><option value="">Choose…</option>{[1, 2, 3, 4, 5].map((n) => <option value={n}>{n} · {s.opts[n]}</option>)}</select>
              </label>
            ))}
            <div><button class="btn" type="submit">Submit rating</button></div>
          </form>
        </div>
      </section>
    </div>
  </div>

  {similar.length > 0 && (
    <section style="background:var(--paper-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
      <div class="wrap">
        <div class="section-head"><div><div class="eyebrow">If you liked this</div><h2>More on Dark Romance Fan</h2></div></div>
        <div class="shelf">
          {similar.map((b) => <a class="tile" href={`/books/${b.slug}`}><Cover book={b} /><h3>{b.title}</h3><div class="by">{b.author}</div><Meters rating={simRatings[b.id]} /></a>)}
        </div>
      </div>
    </section>
  )}

  <div class="wrap narrow"><Comments bookId={book.id} prompt={`What did you think of ${book.title}?`} /></div>
  <Signup source={`book:${book.slug}`} />
</Base>
