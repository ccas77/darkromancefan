---
const { source = 'site' } = Astro.props;
const ok = Astro.url.searchParams.get('sub');
---
<div class="band" id="signup"><div class="wrap signup">
  <div>
    <div class="eyebrow">Free weekly email</div>
    <h2>Dark Romance Fan: your weekly obsession</h2>
    <p>One email a week for readers who like it dark.</p>
    <ul>
      <li>Free and discounted dark romance, checked before it lands in your inbox</li>
      <li>New releases by trope</li>
      <li>The books our readers can't stop talking about</li>
    </ul>
  </div>
  <div>
    {ok === 'ok' && <div class="flash">You're in. Check your inbox.</div>}
    {ok === 'bad' && <div class="flash">That email didn't look right. Try again?</div>}
    <form method="post" action="/api/subscribe">
      <input type="email" name="email" placeholder="Your email address" required aria-label="Email address" />
      <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="source" value={source} />
      <button class="btn" type="submit">Subscribe</button>
    </form>
    <p class="fine">Unsubscribe any time. 18+ only.</p>
  </div>
</div></div>
